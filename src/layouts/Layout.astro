---
import "../styles/global.css";
import { ui } from "../i18n/ui.js";

const user = Astro.locals.user; 
const locale = (Astro.locals.lang ?? "en");
---

<!doctype html>
<html lang="fr" data-theme="cupcake">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>

  <body class="h-full">
    <div class="h-full flex flex-col min-h-0">

      <div class="navbar bg-base-200 px-4">
        <div class="flex-1">
          <a href="/" class="btn btn-ghost normal-case text-xl">Home</a>
        </div>

        <div class="flex-none">
          <ul class="menu menu-horizontal px-1 items-center gap-2">
            <li><a href="/generator">Generator</a></li>
            <li><a href="/gallery">gallery</a></li>
            <li>
            <li>
              <form method="POST" action={Astro.url.pathname}>
                <select name="language" class="select select-bordered select-sm" onchange="this.form.submit()">
                  <option disabled selected="true">{ui[locale].nav.language}</option>
                  <option value="en">English</option>
                  <option value="fr">Français</option>
                </select>
              </form>
            </li>

            {user ? (
              <>
                <li>
                  <span class="text-sm opacity-70">
                    Bonjour {user.email}
                  </span>
                </li>
                <li>
                  <form action="/api/logout" method="POST">
                    <button class="btn btn-outline btn-error btn-sm">Logout</button>
                  </form>
                </li>
              </>
            ) : (
              <>
                <li><a href="/login" class="btn btn-sm btn-outline">Sign In</a></li>
                <li><a href="/signup" class="btn btn-sm btn-primary">Sign Up</a></li>
              </>
            )}
          </ul>
        </div>
      </div>

      <div class="flex-1 min-h-0">
        <slot />
      </div>
    </div>
  </body>
</html>

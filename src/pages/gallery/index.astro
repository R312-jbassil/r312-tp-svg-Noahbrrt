---
import Layout from "../../layouts/Layout.astro";
import PocketBase from "pocketbase";
import { ui } from "../../i18n/ui.js"; 

const pb = new PocketBase(import.meta.env.PB_URL || "http://127.0.0.1:8090");

const user = Astro.locals.user;
const locale = Astro.locals.lang ?? "en"; 

let records = [];

if (user) {
  records = await pb.collection("svgs").getFullList({
    sort: "-created",
    filter: `user = "${user.id}"`, 
  });
} else {
  return Astro.redirect("/login");
}
---

<Layout>
  <div class="max-w-6xl mx-auto p-6 space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-indigo-700">
        {ui[locale].gallery.title}
      </h1>
      <a href="/generator" class="btn btn-primary">
        ← {ui[locale].gallery.returnToGenerator ?? "Retour au générateur"}
      </a>
    </div>

    {records.length === 0 ? (
      <div class="alert alert-info">
        <span>{ui[locale].gallery.noSVG ?? "Aucun SVG enregistré pour le moment."}</span>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 gap-6">
        {records.map((rec) => (
          <div class="card bg-white shadow-md p-4">
            <h2 class="font-semibold text-lg mb-2">{rec.name}</h2>
            <div class="border border-dashed border-gray-300 rounded-lg p-4 bg-gray-50">
              <div set:html={rec.code_svg}></div>
            </div>
            <pre class="bg-gray-100 rounded mt-3 p-2 text-xs overflow-x-auto">
              <code>{rec.code_svg}</code>
            </pre>

            <a href={`/gallery/${rec.id}`} class="btn btn-outline btn-info mt-3">
              {ui[locale].gallery.viewDetails}
            </a>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>

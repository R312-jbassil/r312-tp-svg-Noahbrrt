---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui";

const locale = (Astro.locals.lang ?? "en");
---

<Layout>
  <div class="flex flex-col h-full items-center justify-center p-10">
    <h1 class="text-4xl font-bold mb-4">{ui[locale].index.title}</h1>
    <p class="mb-6 text-lg">{ui[locale].index.description}</p>
    <a href="/generator" class="btn btn-primary">{ui[locale].index.button}</a>
  </div>
</Layout>

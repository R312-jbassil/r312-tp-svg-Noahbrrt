---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui.js"; 
const user = Astro.locals.user;
const locale = Astro.locals.lang ?? "en"; 
---

<Layout>
  <div class="grid grid-cols-1 md:grid-cols-2 h-[calc(100vh-4rem)]">
    
    <div class="flex flex-col items-center justify-center bg-base-200 p-4">
      <div id="svg-container" class="w-full h-full flex items-center justify-center border rounded bg-white">
        <span class="text-gray-400">
          {ui[locale].generator.contentPlaceholder}
        </span>
      </div>

      <div class="mt-4">
        <button id="save-btn" class="btn btn-success">
          {ui[locale].generator.saveButton ?? "Save"}
        </button>
      </div>
    </div>

    <div class="flex flex-col bg-base-300 relative">
      
      <div class="divider">{ui[locale].generator.title}</div>

      <div id="chat-history" class="flex flex-col gap-4 w-full mb-20 overflow-y-auto flex-grow p-4">
        <span class="text-gray-400">{ui[locale].generator.noMessages ?? "Aucun message pour l’instant…"}</span>
      </div>

      <form id="input-prompt-form" class="flex flex-col gap-2 w-full absolute bottom-0 left-0 right-0 bg-base-100 p-4" autocomplete="off">
  <div class="flex items-center gap-2">
    <input
      id="prompt-input"
      type="text"
      class="input flex-grow"
      placeholder={ui[locale].generator.promptLabel}
    />
    <button class="btn btn-primary" type="button" id="generate-btn">
      Générer
    </button>
    <button class="btn btn-secondary" type="submit">
      {ui[locale].generator.editButton}
    </button>
  </div>
</form>

  <script>
    //@ts-nocheck
    let history = [];
    let lastSVG = "";
    let currentEditId = null;

    async function generateSVG(messages) {
      const res = await fetch("/api/generateSVG", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(messages),
      });
      const data = await res.json();
      return data.svg || "";
    }

    async function handleGeneration(e) {
      e.preventDefault();
      const input = document.getElementById("prompt-input");
      const svgContainer = document.getElementById("svg-container");

      const prompt = input.value.trim();
      if (!prompt) return;

      addMessage("user", prompt);
      history.push({ role: "user", content: prompt });
      input.value = "";

      svgContainer.innerHTML = '<span class="loading loading-ring loading-xl"></span>';

      try {
        const result = await generateSVG(history);
        const aiResponse = result.content || "";
        lastSVG = aiResponse;
        history.push({ role: "assistant", content: aiResponse });
        addMessage("assistant", aiResponse);
        svgContainer.innerHTML = aiResponse || '<span class="text-gray-400">Aucun SVG reçu</span>';
      } catch (err) {
        console.error(err);
        addMessage("assistant", "⚠️ Erreur lors de la génération");
        svgContainer.innerHTML = '<span class="text-error">Erreur serveur</span>';
      }
    }

    function addMessage(role, content) {
      const chatHistory = document.getElementById("chat-history");
      if (chatHistory.querySelector("span.text-gray-400")) chatHistory.innerHTML = "";

      const wrapper = document.createElement("div");
      wrapper.classList.add("chat", role === "user" ? "chat-start" : "chat-end");

      const bubble = document.createElement("div");
      bubble.classList.add("chat-bubble");
      if (role === "user") {
        bubble.classList.add("bg-primary", "text-primary-content");
      } else {
        bubble.classList.add("bg-secondary", "text-secondary-content");
      }

      const pre = document.createElement("pre");
      pre.classList.add("whitespace-pre-wrap");
      pre.textContent = content;

      bubble.appendChild(pre);
      wrapper.appendChild(bubble);

      const footer = document.createElement("div");
      footer.classList.add("chat-footer", "opacity-60", "text-xs", "mt-1");
      footer.textContent = role;

      wrapper.appendChild(footer);

      chatHistory.appendChild(wrapper);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    document.getElementById("generate-btn")?.addEventListener("click", handleGeneration);

    document.getElementById("input-prompt-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!currentEditId) {
        handleGeneration(e);
        return;
      }

      const input = document.getElementById("prompt-input");
      const svgContainer = document.getElementById("svg-container");
      const prompt = input.value.trim();
      if (!prompt) return;

      try {
        const result = await fetch("/api/updateSVG", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id: currentEditId,
            code_svg: svgContainer.innerHTML,
            chat_history: JSON.stringify([...history, { role: "user", content: prompt }])
          })
        });

        if (!result.ok) {
          throw new Error("Failed to update SVG");
        }

        await handleGeneration(e);
        
      } catch (err) {
        console.error("Error updating SVG:", err);
        alert("Error updating SVG");
      }
    });

    document.getElementById("save-btn")?.addEventListener("click", async () => {
      if (!lastSVG) {
        alert("⚠️ Aucun SVG à sauvegarder !");
        return;
      }

      const user = JSON.parse(localStorage.getItem("user"));
      if (!user) {
        alert("⚠️ Vous devez être connecté pour sauvegarder un SVG.");
        return;
      }

      const name = prompt("Nom du SVG :", "");
      if (!name) return;

      try {
        const svgData = {
          name,
          code_svg: lastSVG,
          chat_history: JSON.stringify(history),
          user: user.id,
        };

        const res = await fetch("/api/saveSVG", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(svgData),
        });

        const data = await res.json();

        if (data.success) {
          alert("✅ SVG sauvegardé avec succès !");
        } else {
          alert("❌ Erreur lors de la sauvegarde : " + (data.error || "inconnue"));
        }
      } catch (err) {
        console.error(err);
        alert("🚨 Erreur réseau lors de la sauvegarde.");
      }
    });
  </script>
</Layout>
